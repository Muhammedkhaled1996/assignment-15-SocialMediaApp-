# ==========================================================
# TROZIANA ENTERPRISE TRAVEL ERP — ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APPLICATION_NAME="Troziana Travel ERP"
LOG_LEVEL=debug

# Database Configuration (MongoDB Replica Set required for multi-document transactions)
DB_URI="mongodb://localhost:27017/troziana_erp?replicaSet=rs0"
DB_NAME="troziana_erp"

# Cache & Rate Limiting (Redis)
ENABLE_REDIS=false
REDIS_URI="redis://default@127.0.0.1:6379"

# Security & Field Encryption (AES-256-CBC 64-hex-char key)
ENC_KEY="3d88b061c0dff8d64ab977f700e476e15731f5585fdf840b146b8e76d5f82647"
IV_LENGTH=16

# JWT Authentication Secrets & Expiry (in seconds)
ACCESS_TOKEN_EXPIRES_IN=900
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_EXPIRES_IN=604800
REFRESH_TOKEN_EXPIRY=604800
ACCESS_USER_TOKEN_SIGNATURE="e773619223bebbb1abe0d093534810e702ef49804d99ff5b17ef46e6cc59654a"
REFRESH_USER_TOKEN_SIGNATURE="9985e724a2cbf1a18bd21f8a2776aee9b1391090a6ea7d367e680c723f0b399e"

# CORS & Cookies
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:3001"
ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000"
COOKIE_DOMAIN="localhost"

# SMTP Email Configuration
APP_EMAIL="noreply@troziana.com"
APP_PASSWORD=""

# File Storage Configuration (LOCAL | S3)
FILE_STORAGE_PROVIDER="LOCAL"
ATTACHMENT_STORAGE="LOCAL"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-north-1"
AWS_BUCKET_NAME="troziana-erp-assets"

# Background Jobs & Operational Policies
JOB_QUEUE_INTERVAL_MS=60000
PASSPORT_MIN_VALIDITY_MONTHS=6
PASSPORT_POLICY_MODE="REJECT"
BOOKING_HOLD_DEFAULT_MINUTES=30
